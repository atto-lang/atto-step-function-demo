// In-memory native Oreslang Workflow actor: strict single-run state transitions.
// Fixed string labels are test data, NOT authenticated tenant/run identities.
// No durable store, source input parser, async external effect or real approval.
define actor WorkflowCoordinator as
  let String phase = "created";

  receive(ActorMail<String> mail): void {
    // Out-of-order completion must never advance created -> completed.
    if mail.value == "tenant-a:run-1:complete"; do
      if self.phase == "running"; do
        self.phase = "completed";
        self.send("completed");
        self.end();
        return;
      fi
      self.send("out-of-order");
      return;
    fi

    if mail.value == "tenant-a:run-1:start"; do
      if self.phase == "created"; do
        self.phase = "running";
        self.send("started");
        return;
      fi
      self.send("duplicate-start");
      return;
    fi

    self.send("rejected");
    return;
  }
end

pub async routine main(): void {
  val coordinator = await spawn WorkflowCoordinator();

  // A completion before start is rejected without mutating workflow phase.
  coordinator.send("tenant-a:run-1:complete");
  val out_of_order = (await coordinator.outputs.next()).value.unwrap();
  if out_of_order.value != "out-of-order"; do
    stdio.stdout.write("workflow:unsafe-out-of-order");
    return;
  fi

  // A foreign run message cannot advance this fixed fixture.
  coordinator.send("tenant-b:run-1:start");
  val foreign = (await coordinator.outputs.next()).value.unwrap();
  if foreign.value != "rejected"; do
    stdio.stdout.write("workflow:unsafe-foreign");
    return;
  fi

  coordinator.send("tenant-a:run-1:start");
  val started = (await coordinator.outputs.next()).value.unwrap();
  if started.value != "started"; do
    stdio.stdout.write("workflow:unsafe-start");
    return;
  fi

  coordinator.send("tenant-a:run-1:start");
  val duplicate = (await coordinator.outputs.next()).value.unwrap();
  if duplicate.value != "duplicate-start"; do
    stdio.stdout.write("workflow:unsafe-duplicate");
    return;
  fi

  coordinator.send("tenant-a:run-1:complete");
  val completed = (await coordinator.outputs.next()).value.unwrap();
  await coordinator.get_done();
  if completed.value == "completed"; do
    stdio.stdout.write("workflow:state-guarded");
    return;
  fi
  stdio.stdout.write("workflow:unsafe-completion");
  return;
}
