// Native AttoLang actor graph: capture -> verify fixture -> choice -> index.
// IMPORTANT: "verified-fixture" is a local, fixed demonstration signal.
// This file DOES NOT verify GitHub runs, persist data, or grant CI authority.
define actor CaptureEvent as
  receive(ActorMail<String> mail): void {
    if mail.value eq "source-event-fixture"; do
      self.send("captured-fixture");
    else
      self.send("capture-rejected");
    fi
    self.end();
    return;
  }
end

define actor VerifyFixture as
  receive(ActorMail<String> mail): void {
    if mail.value eq "captured-fixture"; do
      self.send("verified-fixture-only");
    else
      self.send("quarantine");
    fi
    self.end();
    return;
  }
end

define actor IndexEphemeral as
  receive(ActorMail<String> mail): void {
    if mail.value eq "verified-fixture-only"; do
      self.send("indexed-ephemeral");
    else
      self.send("quarantine");
    fi
    self.end();
    return;
  }
end

pub async routine main(): void {
  val capture = await spawn CaptureEvent();
  capture.send("source-event-fixture");
  val received = (await capture.outputs.next()).value.unwrap();
  await capture.get_done();

  val verify = await spawn VerifyFixture();
  verify.send(received.value);
  val decision = (await verify.outputs.next()).value.unwrap();
  await verify.get_done();

  if decision.value eq "verified-fixture-only"; do
    val index = await spawn IndexEphemeral();
    index.send(decision.value);
    val result = (await index.outputs.next()).value.unwrap();
    await index.get_done();
    if result.value eq "indexed-ephemeral"; do
      stdio.stdout.write("memory:fixture-indexed");
      return;
    fi
  fi
  stdio.stdout.write("memory:quarantined");
  return;
}
