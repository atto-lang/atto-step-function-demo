// Real AttoLang source guest: three independently supervised step actors.
// The root async task is a temporary coordinator; this is NOT a durable Workflow actor.
define actor ValidateStep as
  receive(ActorMail<String> mail): void {
    if mail.value eq "order"; do
      self.send("validated");
    else
      self.send("rejected");
    fi
    self.end();
    return;
  }
end

define actor ProcessStep as
  receive(ActorMail<String> mail): void {
    if mail.value eq "validated"; do
      self.send("processed");
    else
      self.send("rejected");
    fi
    self.end();
    return;
  }
end

define actor CompleteStep as
  receive(ActorMail<String> mail): void {
    if mail.value eq "processed"; do
      self.send("complete");
    else
      self.send("rejected");
    fi
    self.end();
    return;
  }
end

pub async routine main(): void {
  val validation = await spawn ValidateStep();
  validation.send("order");
  val validated = (await validation.outputs.next()).value.unwrap();
  await validation.get_done();

  // Assert upstream stage contracts before forwarding values to the next actor.
  if validated.value neq "validated" then panic("validation stage output drift"); fi
  val processing = await spawn ProcessStep();
  processing.send(validated.value);
  val processed = (await processing.outputs.next()).value.unwrap();
  await processing.get_done();

  if processed.value neq "processed" then panic("processing stage output drift"); fi
  val completion = await spawn CompleteStep();
  completion.send(processed.value);
  val completed = (await completion.outputs.next()).value.unwrap();
  await completion.get_done();

  stdio.stdout.write(completed.value);
  return;
}
